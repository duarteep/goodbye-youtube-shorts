{
  "manifest_version": 3,
  "name": "Goodbye YouTube Shorts",
  "version": "1.2.0",
  "description": "Remove Shorts links and suggestions from YouTube.",
  "permissions": ["scripting", "activeTab", "storage", "tabs"],
  "host_permissions": ["https://www.youtube.com/*"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Goodbye YouTube Shorts"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
